# Domain pointing at this server (A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=alror.example.com

# Generate each with: openssl rand -hex 24   (session secret: openssl rand -base64 48)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ALROR_SESSION_SECRET=

# Comma-separated emails allowed into /admin (the instance operator panel).
ALROR_PLATFORM_ADMINS=
